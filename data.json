// Combine all sources
const allArticles = [...articles, ...staticSources];

// ============================================
// SEARCH FUNCTION
// ============================================

function searchArticles(query, articlesList) {
  if (!query) return [];
  
  const queryLower = query.toLowerCase().trim();
  if (queryLower.length < 2) return [];
  
  const results = [];
  
  for (const article of articlesList) {
    const content = article.content || '';
    const title = article.title || '';
    
    let score = 0;
    
    // Title match
    if (title.toLowerCase().includes(queryLower)) {
      score += 20;
    }
    
    // Word matches
    const words = queryLower.split(/\s+/);
    for (const word of words) {
      if (word.length > 2) {
        const count = (content.toLowerCase().match(new RegExp(word, 'g')) || []).length;
        score += count * 3;
      }
    }
    
    // Phrase match
    if (content.toLowerCase().includes(queryLower)) {
      score += 10;
    }
    
    if (score > 0) {
      results.push({
        ...article,
        score: score,
        relevance: Math.min(Math.round((score / 50) * 100), 100)
      });
    }
  }
  
  results.sort((a, b) => b.score - a.score);
  return results.slice(0, 5);
}

// ============================================
// API HANDLER - Vercel Compatible
// ============================================

export default async function handler(req, res) {
  // CORS headers
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  // OPTIONS preflight
  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  // Only GET and POST
  if (req.method !== 'GET' && req.method !== 'POST') {
    return res.status(405).json({
      error: 'Method not allowed',
      allowed: ['GET', 'POST']
    });
  }

  try {
    // Get parameters
    let query = null;
    let action = null;

    if (req.method === 'GET') {
      query = req.query.query || null;
      action = req.query.action || null;
    } else {
      query = req.body?.query || null;
      action = req.body?.action || null;
    }

    // Health check
    if (action === 'health' || action === 'ping') {
      return res.status(200).json({
        status: 'ok',
        timestamp: new Date().toISOString(),
        total_articles: allArticles.length,
        sources: [...new Set(allArticles.map(a => a.source_name))]
      });
    }

    // Get all articles
    if (action === 'all') {
      return res.status(200).json({
        total: allArticles.length,
        articles: allArticles.map(a => ({
          title: a.title,
          source: a.source_name,
          author: a.author || 'Unknown',
          date: a.date,
          url: a.url,
          word_count: a.word_count,
          hash: a.hash
        }))
      });
    }

    // Search
    if (query) {
      const results = searchArticles(query, allArticles);
      
      return res.status(200).json({
        query: query,
        total: results.length,
        results: results.map(r => ({
          title: r.title,
          source: r.source_name,
          author: r.author || 'Unknown',
          date: r.date,
          url: r.url,
          relevance: r.relevance,
          content_preview: (r.content || '').substring(0, 300) + '...'
        }))
      });
    }

    // Default API info
    return res.status(200).json({
      name: 'TechCrunch RAG API',
      version: '1.0.0',
      endpoints: {
        search: '?query=your+question',
        health: '?action=health',
        all: '?action=all'
      },
      total_articles: allArticles.length,
      sources: [...new Set(allArticles.map(a => a.source_name))]
    });

  } catch (error) {
    console.error('API Error:', error.message);
    return res.status(500).json({
      error: 'Internal server error',
      message: error.message || 'Unknown error',
      timestamp: new Date().toISOString()
    });
  }
}
