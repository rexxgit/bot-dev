{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/api/admin",
      "dest": "/api/admin"
    },
    {
      "src": "/api/audit",
      "dest": "/api/audit"
    },
    {
      "src": "/api/auth",
      "dest": "/api/auth"
    },
    {
      "src": "/api/data",
      "dest": "/api/data"
    },
    {
      "src": "/api/evaluate",
      "dest": "/api/evaluate"
    },
    {
      "src": "/api/privacy",
      "dest": "/api/privacy"
    },
    {
      "src": "/api/sources",
      "dest": "/api/sources"
    },
    {
      "src": "/api/trigger",
      "dest": "/api/trigger"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "outputDirectory": "."
}
