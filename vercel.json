{
  "version": 2,
  "functions": {
    "api/data.js": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/api/data",
      "dest": "/api/data"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/data"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
